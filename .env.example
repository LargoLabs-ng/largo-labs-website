# Copy this file to .env.local for local testing, and add the same variables
# in your hosting provider's dashboard (e.g. Vercel → Project → Settings → Environment Variables).

# REQUIRED for the contact form. The ID from your Formspree form's endpoint:
#   https://formspree.io/f/abcdwxyz  →  FORMSPREE_FORM_ID=abcdwxyz
# Without it, the form tells visitors their message was NOT sent (it never fakes success).
FORMSPREE_FORM_ID=

# The live website address, with https:// and no trailing slash.
# Enables canonical URLs, search-engine indexing, and correct sitemap/Open Graph links.
# (You can set `domain` in src/config/site.ts instead.)
NEXT_PUBLIC_SITE_URL=
